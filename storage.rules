rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar người dùng: Cho phép mọi người đọc, nhưng chỉ chủ sở hữu mới được ghi
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Avatar nhóm: Cho phép mọi thành viên đọc và ghi (hoặc tùy biến thêm nếu cần)
    match /group_avatars/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // File đính kèm ghi chú: Chỉ chủ sở hữu mới được đọc và ghi
    match /note_attachments/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // File đính kèm chat: Chỉ những người tham gia cuộc hội thoại mới được đọc/ghi
    // Ở đây đơn giản hóa là cho phép mọi user đã đăng nhập, 
    // nhưng thực tế nên kiểm tra chatId có chứa uid của user không.
    match /chat_attachments/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Quy tắc mặc định: Chặn tất cả các truy cập khác
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
