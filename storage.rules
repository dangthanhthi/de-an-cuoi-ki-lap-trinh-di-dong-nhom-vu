rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
          && request.resource.contentType.matches('image/.*');
    }

    function under(sizeInMb) {
      return request.resource != null
          && request.resource.size < sizeInMb * 1024 * 1024;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
          && request.auth.uid == uid
          && isImage()
          && under(5);
    }

    match /group_avatars/{groupId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
          && isImage()
          && under(5);
    }

    match /note_attachments/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
          && request.auth.uid == uid
          && under(30);
    }

    match /chat_attachments/{chatId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && under(30);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
