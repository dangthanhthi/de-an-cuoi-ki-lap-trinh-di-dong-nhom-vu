rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function currentEmail() {
      return request.auth.token.email;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userDoc(uid) {
      return get(userPath(uid));
    }

    function isAdmin() {
      return signedIn()
          && userExists(currentUid())
          && userDoc(currentUid()).data.role == 'Admin';
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupExists(groupId) {
      return groupId is string
          && groupId != ''
          && exists(groupPath(groupId));
    }

    function groupDoc(groupId) {
      return get(groupPath(groupId));
    }

    function hasListValue(data, key, value) {
      return data.keys().hasAny([key])
          && data[key] is list
          && value in data[key];
    }

    function isGroupMember(groupId) {
      return signedIn()
          && groupExists(groupId)
          && (
            hasListValue(groupDoc(groupId).data, 'members', currentEmail())
            || hasListValue(groupDoc(groupId).data, 'memberEmails', currentEmail())
          );
    }

    function isGroupLeader(groupId) {
      return signedIn()
          && groupExists(groupId)
          && groupDoc(groupId).data.leaderId == currentUid();
    }

    function isGroupManager(groupId) {
      return signedIn()
          && groupExists(groupId)
          && hasListValue(groupDoc(groupId).data, 'managerEmails', currentEmail());
    }

    function canManageGroup(groupId) {
      return isAdmin() || isGroupLeader(groupId) || isGroupManager(groupId);
    }

    function notePath(noteId) {
      return /databases/$(database)/documents/notes/$(noteId);
    }

    function noteExists(noteId) {
      return exists(notePath(noteId));
    }

    function noteDoc(noteId) {
      return get(notePath(noteId));
    }

    function isNoteOwner(data) {
      return signedIn() && data.userId == currentUid();
    }

    function isSharedNoteViewer(data) {
      return signedIn() && currentEmail() in data.sharedWith;
    }

    function isGroupNote(data) {
      return data.groupId is string && data.groupId != '';
    }

    function canReadNote(data) {
      return signedIn()
          && (
            isAdmin()
            || isNoteOwner(data)
            || isSharedNoteViewer(data)
            || (isGroupNote(data) && isGroupMember(data.groupId))
          );
    }

    function canEditNoteContent(data) {
      return signedIn()
          && (
            isAdmin()
            || isNoteOwner(data)
            || (isGroupNote(data) && isGroupMember(data.groupId))
          );
    }

    function canManageNote(data) {
      return signedIn()
          && (
            isAdmin()
            || isNoteOwner(data)
            || (isGroupNote(data) && canManageGroup(data.groupId))
          );
    }

    function ownUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.isBanned == resource.data.isBanned
          && request.resource.data.isDeleted == resource.data.isDeleted
          && changed.hasOnly([
            'name',
            'avatar',
            'settings',
            'isOnline',
            'lastActive',
            'updatedAt',
          ]);
    }

    function adminUserUpdate() {
      return isAdmin()
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role',
            'isBanned',
            'isDeleted',
            'deletedAt',
            'deletedBy',
            'deletedByEmail',
            'updatedAt',
          ]);
    }

    function validUserCreate(userId) {
      return signedIn()
          && userId == currentUid()
          && request.resource.data.email == currentEmail()
          && request.resource.data.role == 'User';
    }

    function validContactCreate() {
      return signedIn()
          && (
            request.resource.data.userId == currentUid()
            || request.resource.data.email == currentEmail()
          );
    }

    function validFriendRequestCreate() {
      return signedIn()
          && request.resource.data.from == currentEmail()
          && request.resource.data.to != currentEmail();
    }

    function validChatData(data) {
      return signedIn()
          && data.participants is list
          && data.participants.size() == 2
          && currentEmail() in data.participants;
    }

    function isChatParticipant(data) {
      return signedIn()
          && data.participants is list
          && currentEmail() in data.participants;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function isChatParticipantById(chatId) {
      return exists(chatPath(chatId))
          && isChatParticipant(get(chatPath(chatId)).data);
    }

    function validNoteCreate() {
      return signedIn()
          && request.resource.data.userId == currentUid()
          && request.resource.data.createdByEmail == currentEmail()
          && (
            request.resource.data.groupId == ''
            || isGroupMember(request.resource.data.groupId)
          );
    }

    function noteMetadataOnlyUpdate(data) {
      return canReadNote(data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sharedWith',
            'viewedBy',
            'hiddenBy',
            'pinnedBy',
            'isPinned',
            'updatedAt',
            'updatedByEmail',
            'updatedByName',
          ]);
    }

    function validNoteContentUpdate(data) {
      return canEditNoteContent(data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdByEmail == resource.data.createdByEmail;
    }

    function validGroupCreate() {
      return signedIn()
          && request.resource.data.leaderId == currentUid()
          && hasListValue(request.resource.data, 'members', currentEmail());
    }

    function groupMemberSelfJoin() {
      return signedIn()
          && resource.data.keys().hasAny(['members'])
          && request.resource.data.keys().hasAny(['members'])
          && !hasListValue(resource.data, 'members', currentEmail())
          && request.resource.data.members.hasAll(resource.data.members)
          && hasListValue(request.resource.data, 'members', currentEmail())
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members',
            'updatedAt',
          ]);
    }

    function legacyGroupMembershipRepair() {
      return signedIn()
          && hasListValue(resource.data, 'memberEmails', currentEmail())
          && request.resource.data.keys().hasAny(['members'])
          && request.resource.data.members.hasAll(resource.data.memberEmails)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members',
            'managerEmails',
            'updatedAt',
          ]);
    }

    function groupMemberRuntimeUpdate(groupId) {
      return isGroupMember(groupId)
          && request.resource.data.leaderId == resource.data.leaderId
          && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pinnedBy',
            'unreadCount',
            'lastMessage',
            'lastSender',
            'updatedAt',
          ]);
    }

    function groupManagerUpdate(groupId) {
      return canManageGroup(groupId)
          && request.resource.data.leaderId == resource.data.leaderId
          && request.resource.data.groupCode == resource.data.groupCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'avatar',
            'members',
            'managerEmails',
            'pinnedBy',
            'requiresApproval',
            'unreadCount',
            'lastMessage',
            'lastSender',
            'updatedAt',
          ]);
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if validUserCreate(userId);
      allow update: if signedIn()
          && (
            (userId == currentUid() && ownUserUpdate())
            || (userId != currentUid() && adminUserUpdate())
          );
      allow delete: if isAdmin() && userId != currentUid();

      match /activities/{activityId} {
        allow get, list: if signedIn() && userId == currentUid();
        allow create: if signedIn() && userId == currentUid();
        allow update: if false;
        allow delete: if signedIn() && userId == currentUid();
      }

      match /mutes/{muteId} {
        allow get, list, create, update, delete: if signedIn()
            && userId == currentUid();
      }

      match /blocks/{blockId} {
        allow get: if signedIn();
        allow list, create, update, delete: if signedIn()
            && userId == currentUid();
      }
    }

    match /contacts/{contactId} {
      allow get, list: if signedIn()
          && (
            resource.data.userId == currentUid()
            || resource.data.email == currentEmail()
          );
      allow create: if validContactCreate();
      allow update, delete: if signedIn()
          && (
            resource.data.userId == currentUid()
            || resource.data.email == currentEmail()
          );
    }

    match /friend_requests/{requestId} {
      allow get, list: if signedIn()
          && (
            resource.data.from == currentEmail()
            || resource.data.to == currentEmail()
          );
      allow create: if validFriendRequestCreate();
      allow update, delete: if signedIn()
          && (
            resource.data.from == currentEmail()
            || resource.data.to == currentEmail()
          );
    }

    match /chats/{chatId} {
      allow get, list: if isChatParticipant(resource.data);
      allow create: if validChatData(request.resource.data);
      allow update: if isChatParticipant(resource.data)
          && request.resource.data.participants == resource.data.participants;
      allow delete: if isChatParticipant(resource.data);

      match /messages/{messageId} {
        allow get, list: if isChatParticipantById(chatId);
        allow create: if isChatParticipantById(chatId)
            && request.resource.data.senderEmail == currentEmail();
        allow update, delete: if isChatParticipantById(chatId);
      }
    }

    match /notes/{noteId} {
      allow get, list: if canReadNote(resource.data);
      allow create: if validNoteCreate();
      allow update: if validNoteContentUpdate(resource.data)
          || noteMetadataOnlyUpdate(resource.data);
      allow delete: if canManageNote(resource.data);

      match /comments/{commentId} {
        allow get, list: if noteExists(noteId)
            && canReadNote(noteDoc(noteId).data);
        allow create: if noteExists(noteId)
            && canReadNote(noteDoc(noteId).data)
            && request.resource.data.userEmail == currentEmail();
        allow update: if noteExists(noteId)
            && canReadNote(noteDoc(noteId).data);
        allow delete: if noteExists(noteId)
            && (
              resource.data.userEmail == currentEmail()
              || canManageNote(noteDoc(noteId).data)
            );
      }

      match /history/{historyId} {
        allow get, list: if noteExists(noteId)
            && canReadNote(noteDoc(noteId).data);
        allow create: if noteExists(noteId)
            && canEditNoteContent(noteDoc(noteId).data)
            && request.resource.data.userEmail == currentEmail();
        allow update: if false;
        allow delete: if noteExists(noteId)
            && canManageNote(noteDoc(noteId).data);
      }
    }

    match /note_invites/{inviteId} {
      allow get, list: if signedIn()
          && (
            resource.data.toEmail == currentEmail()
            || resource.data.fromEmail == currentEmail()
            || (noteExists(resource.data.noteId)
                && canManageNote(noteDoc(resource.data.noteId).data))
          );
      allow create: if signedIn()
          && request.resource.data.fromEmail == currentEmail()
          && noteExists(request.resource.data.noteId)
          && canManageNote(noteDoc(request.resource.data.noteId).data);
      allow update, delete: if signedIn()
          && (
            resource.data.toEmail == currentEmail()
            || resource.data.fromEmail == currentEmail()
            || (noteExists(resource.data.noteId)
                && canManageNote(noteDoc(resource.data.noteId).data))
          );
    }

    match /groups/{groupId} {
      allow get: if signedIn();
      allow list: if isAdmin() || isGroupMember(groupId);
      allow create: if validGroupCreate();
      allow update: if groupManagerUpdate(groupId)
          || groupMemberRuntimeUpdate(groupId)
          || groupMemberSelfJoin()
          || legacyGroupMembershipRepair();
      allow delete: if isAdmin() || isGroupLeader(groupId);

      match /comments/{commentId} {
        allow get, list: if isGroupMember(groupId) || isAdmin();
        allow create: if isGroupMember(groupId)
            && request.resource.data.userEmail == currentEmail();
        allow update: if isGroupMember(groupId) || isAdmin();
        allow delete: if isAdmin()
            || canManageGroup(groupId)
            || resource.data.userEmail == currentEmail();
      }

      match /activities/{activityId} {
        allow get, list: if isGroupMember(groupId) || isAdmin();
        allow create: if isGroupMember(groupId) || isAdmin();
        allow update: if false;
        allow delete: if canManageGroup(groupId);
      }
    }

    match /group_codes/{groupCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && groupExists(request.resource.data.groupId)
          && isGroupLeader(request.resource.data.groupId);
      allow update: if false;
      allow delete: if signedIn()
          && groupExists(resource.data.groupId)
          && (isAdmin() || isGroupLeader(resource.data.groupId));
    }

    match /group_invites/{inviteId} {
      allow get, list: if signedIn()
          && (
            resource.data.toEmail == currentEmail()
            || canManageGroup(resource.data.groupId)
          );
      allow create: if signedIn()
          && request.resource.data.fromEmail == currentEmail()
          && canManageGroup(request.resource.data.groupId);
      allow update, delete: if signedIn()
          && (
            resource.data.toEmail == currentEmail()
            || canManageGroup(resource.data.groupId)
          );
    }

    match /group_requests/{requestId} {
      allow get, list: if signedIn()
          && (
            resource.data.userEmail == currentEmail()
            || canManageGroup(resource.data.groupId)
          );
      allow create: if signedIn()
          && request.resource.data.userEmail == currentEmail()
          && groupExists(request.resource.data.groupId);
      allow update, delete: if signedIn()
          && (
            resource.data.userEmail == currentEmail()
            || canManageGroup(resource.data.groupId)
          );
    }

    match /presence/{presenceId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn()
          && request.resource.data.userEmail == currentEmail();
      allow delete: if signedIn()
          && resource.data.userEmail == currentEmail();
    }

    match /ai_chats/{userId}/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
